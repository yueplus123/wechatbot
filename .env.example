# 一键部署.bat 会基于本文件生成 config/.env，并自动换上随机密钥。
# 本文件不放真实密钥。

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Shanghai

# MySQL（正式库；PoC 阶段可暂不启用）
MYSQL_DATABASE=xinhuo_bookkeeper
MYSQL_USER=bookkeeper
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# 网关 HMAC（网关与 Django 同机时仅监听 127.0.0.1）
GATEWAY_ID=wx-gateway-01
GATEWAY_HMAC_SECRET=change-me-hmac-secret
GATEWAY_API_BASE=http://127.0.0.1:8000

# PoC / 网关
POC_CHAT_NAME=请填写真实外部群完整名称
WECHAT_ADAPTER=pyweixin
# pinned=用户单独打开群并图钉置顶 = 自动监听（推荐，默认）
# panel=从面板手动配置群名
WECHAT_LISTEN_SOURCE=pinned
WECHAT_LISTEN_MODE=pinned
WECHAT_ALLOW_SEARCH=0
WECHAT_POLL_SECONDS=2.5
CHAT_LIST_REFRESH_SECONDS=30
DEDUP_WINDOW_SECONDS=15
REPLY_MIN_INTERVAL_SECONDS=0.6
REPLY_MAX_PER_MINUTE=20

# 业务默认
DEFAULT_CURRENCY=CNY
TRIGGER_PREFIX=记账
REVERSE_WINDOW_MINUTES=10
RULE_VERSION=1

# 听群识别：SENDER_AVATAR_CLICK=1 会点头像读资料（会短暂动鼠标）；云电脑无人值守建议先保持 1
SENDER_AVATAR_CLICK=1
SENDER_OCR=0

# 薪火统一对接（xinhuo-bridge）：必须填这两项，否则记账成功但不会推到薪火后台
# 密钥须与薪火后端 .env 里的 EXTERNAL_PUSH_API_KEY 一致
XINHUO_API_BASE=http://192.144.236.133
XINHUO_BOT_PUSH_API_KEY=请填写薪火后端 EXTERNAL_PUSH_API_KEY 的值
# XINHUO_BOT_PUSH_TIMEOUT=8
# XINHUO_BRIDGE_MAX_RETRIES=2
# 可选：覆盖单能力完整 URL（一般不需要）
# XINHUO_LEDGER_PUSH_URL=http://192.144.236.133/api/external/ledger/push/
# XINHUO_BOT_PUSH_URL=http://192.144.236.133/api/external/wechat-bot/push/
# XINHUO_PRODUCT_QUERY_URL=http://192.144.236.133/api/external/wechat-bot/products/
